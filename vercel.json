{
  "buildCommand": "npm run build && node scripts/holding-page.mjs",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.ukmortgagesworldwide.com" }
      ],
      "destination": "https://ukmortgagesworldwide.com/:path*",
      "permanent": true
    },
    {
      "source": "/expat-mortgages/buy-to-let-from-abroad",
      "destination": "/expat-mortgages/buy-to-let",
      "permanent": true
    },
    {
      "source": "/expat-mortgages/buy-to-let/rates",
      "destination": "/expat-mortgages/buy-to-let",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
