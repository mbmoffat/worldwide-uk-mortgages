---
import HubLayout from '../../layouts/HubLayout.astro';
import PullQuote from '../../components/PullQuote.astro';
import MidPageCta from '../../components/MidPageCta.astro';
import { breadcrumbSchema, articleSchema } from '../../lib/schema';
import RiskWarning from '../../components/RiskWarning.astro';
import TerritorialScope from '../../components/TerritorialScope.astro';

const title = 'UK Mortgages Without ILR';
const description =
  'How UK mortgage applications work for visa holders without ILR. Lender criteria, deposit thresholds, visa time remaining, and the routes that work.';
const h1 = 'UK Mortgages Without Indefinite Leave to Remain';
const subheadline = description;

const faqs = [
  {
    q: 'Can I get a UK mortgage without ILR?',
    a: 'Yes. Not having ILR narrows the lender pool but does not close it. Many UK lenders work with visa holders on Skilled Worker, Spouse, BNO, Global Talent and similar visas. The application has to be structured for the right lender, but a well-placed case is achievable for most visa types with adequate time remaining and a reasonable deposit.',
  },
  {
    q: 'Does ILR make it easier to get a UK mortgage?',
    a: 'Yes. With ILR, most lenders treat you as a standard residential applicant. Without ILR, you are assessed under non-standard criteria. That said, many lenders have specific non-ILR criteria and lend on sensible terms to visa holders. The difference is mainly in which lenders are available and how they assess the application, not whether a mortgage is possible at all.',
  },
  {
    q: 'How much visa time remaining do I need to get a mortgage without ILR?',
    a: '12 months remaining on your current visa is the threshold for a reasonable number of mainstream lenders. 24 months opens the pool further. Below 12 months, the pool shrinks but does not disappear. Some lenders will consider applications where the visa is mid-renewal, particularly with a strong renewal track record. The pool of available lenders changes at each of these benchmarks.',
  },
  {
    q: 'What deposit do I need for a mortgage without ILR?',
    a: 'Five to ten per cent is possible for some visa profiles, particularly Spouse visa joint applications and certain Skilled Worker cases. Fifteen per cent is workable for most well-evidenced applications with adequate visa time remaining. Twenty-five per cent and above opens specialist lender and private bank options. A larger deposit does more for a non-ILR application than it does for an ILR one, because each band change affects which lenders are practically available.',
  },
  {
    q: 'Can I get a buy-to-let mortgage without ILR?',
    a: 'Yes. The buy-to-let lender pool for non-ILR applicants is smaller than for residential mortgages, but options exist. Assessment tends to focus on rental yield and overall financial standing rather than visa time remaining as the primary metric. Specialist lenders are more commonly involved than on residential applications.',
  },
  {
    q: 'Will applying for a mortgage affect my ILR application?',
    a: 'No. A mortgage is a separate financial transaction with no connection to your immigration application. Lenders do not notify the Home Office and taking out a mortgage does not affect your path to Indefinite Leave to Remain. A mortgage is often viewed positively as evidence of roots and financial stability.',
  },
  {
    q: 'Which visa types can get a UK mortgage without ILR?',
    a: 'The most commonly considered visas are Skilled Worker, Spouse and partner visas, BNO visa, Global Talent visa, and Health and Care Worker visa. Student and Graduate visas have a much smaller lender pool. If your visa type is not listed, there are usually still options. A specialist broker will map your visa type against current lender criteria before any application is submitted.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const relatedPages = [
  {
    eyebrow: 'Hub',
    title: 'UK Mortgages for Foreign Nationals',
    description:
      'Foreign nationals living in the UK who want to buy or remortgage. Visa types, deposits, and lender appetite.',
    href: '/uk-mortgage-for-foreign-nationals',
  },
  {
    eyebrow: 'Visa-Holder Mortgages',
    title: 'UK Mortgages on a Skilled Worker Visa',
    description:
      'Skilled Worker visa applications. Visa time remaining, deposit, and which lenders are open to your profile.',
    href: '/uk-mortgage-for-foreign-nationals/skilled-worker-visa',
  },
  {
    eyebrow: 'Visa-Holder Mortgages',
    title: 'UK Mortgages on a Spouse Visa',
    description:
      'Spouse visa applications, jointly with a British partner or alone. Lender appetite and deposit expectations.',
    href: '/uk-mortgage-for-foreign-nationals/spouse-visa',
  },
  {
    eyebrow: 'Visa-Holder Mortgages',
    title: 'UK Mortgages on a BNO Visa',
    description:
      'British National Overseas visa mortgage applications. HKD savings and income, lender appetite, and deposit.',
    href: '/uk-mortgage-for-foreign-nationals/bno-visa',
  },
  {
    eyebrow: 'Hub',
    title: 'UK Mortgages with Foreign Income',
    description:
      'How lenders treat non-sterling income. The 20% standard haircut and access to no-haircut lenders.',
    href: '/uk-mortgage-foreign-income',
  },
];

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'UK Mortgages for Foreign Nationals', path: '/uk-mortgage-for-foreign-nationals' },
    { name: title, path: '/uk-mortgage-for-foreign-nationals/without-ilr' },
  ]),
  articleSchema({ headline: h1, description }),
];
---

<HubLayout
  title={title}
  description={description}
  h1={h1}
  subheadline={subheadline}
  eyebrow="Visa-Holder Mortgages"
  schemas={schemas}
  relatedPages={relatedPages}
>
  <RiskWarning type="residential" />
  <TerritorialScope />
  <section class="hub-section">
    <div class="hub-section-inner">
      <p>
        ILR is the threshold most UK lenders use to sort applicants into two
        boxes. With ILR, you are treated as a standard residential applicant.
        Without it, you are non-standard. That sounds like a barrier and it
        sometimes feels like one, but plenty of lenders work with non-ILR
        applicants and several do it well.
      </p>
      <p>
        The decision is rarely about whether you can borrow. It is about
        which lender will see your application without applying restrictions
        that make the borrowing too small or the rate too expensive.
      </p>
    </div>
  </section>

  <PullQuote>
    Without ILR, the lender shortlist gets shorter, but it does not
    disappear. The work is finding the lenders that lend on profiles like
    yours and structuring the case for them.
  </PullQuote>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="who-this-is-for">Who this page is for</h2>
      <p>
        You are in the UK on a visa, you do not yet have ILR, and you want
        to buy or remortgage. You want to know which lenders will consider
        your application, how much you can borrow, and what the application
        will require.
      </p>
    </div>
  </section>

  <MidPageCta variant="hero" />

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="why-ilr-matters">Why ILR matters to lenders</h2>
      <p>
        Lenders care about ILR for one reason: it tells them that the
        applicant has a permanent right to remain in the UK. If you have
        ILR, they assume you will be here to repay the loan. Without ILR,
        they have to make a judgement about visa duration, renewal
        likelihood, and the strength of your reasons for staying.
      </p>
      <p>
        Some lenders make that judgement quickly and open-mindedly. Others
        apply blanket rules. The difference between a confident "yes" and an
        automated "no" is usually which lender you approach, not the
        underlying facts of your application.
      </p>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="which-visas">Which visas lenders will consider</h2>
      <p>The lender appetite is broadly:</p>
      <ul>
        <li><strong>Skilled Worker visa.</strong> Widely considered. Most high street lenders have published criteria.</li>
        <li><strong>Spouse and partner visas.</strong> Widely considered, particularly with a British partner on the application.</li>
        <li><strong>BNO visa.</strong> Considered by a growing number of lenders. HSBC and certain specialists are particularly comfortable.</li>
        <li><strong>Global Talent visa.</strong> Considered by mainstream lenders, often viewed favourably.</li>
        <li><strong>Tier 1 Investor (legacy).</strong> Specialist territory, often via private banks for larger loans.</li>
        <li><strong>Student visa.</strong> Very limited. Specialist only.</li>
        <li><strong>Graduate visa.</strong> Limited. Specialist only.</li>
        <li><strong>Health and Care Worker visa.</strong> Considered by a meaningful subset, criteria similar to Skilled Worker.</li>
      </ul>
      <p>
        If your visa is not on this list, that is what the first conversation
        is for. There are usually options.
      </p>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="visa-time-remaining">Visa time remaining</h2>
      <p>
        This is the single biggest variable for non-ILR applications. The
        benchmarks across the lender market are:
      </p>
      <ul>
        <li>12 months remaining: a reasonable number of mainstream lenders will engage</li>
        <li>24 months remaining: the pool widens significantly</li>
        <li>Less than 12 months: smaller pool, but workable with the right lender and a clear renewal pathway</li>
        <li>Visa in renewal: a small group of lenders will still consider, particularly with strong supporting context</li>
      </ul>
      <p>
        The pool of lenders shrinks as the time remaining shrinks. It does
        not disappear.
      </p>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="deposit-by-visa">Deposit by visa profile</h2>
      <p>Deposit expectations vary by visa type and time remaining:</p>
      <ul>
        <li>5 per cent: possible for some Spouse visa joint applications and a small group of Skilled Worker cases</li>
        <li>10 per cent: workable for most well-evidenced visa applications with adequate time remaining</li>
        <li>15 to 25 per cent: opens the broader mainstream lender pool, including high street names</li>
        <li>25 per cent and above: specialist lender and private bank options for larger or non-standard cases</li>
      </ul>
      <p>
        A bigger deposit does more for a non-ILR application than it does
        for an ILR one. Each band increase changes which lenders are
        practically available.
      </p>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="high-street-vs-specialist">High street versus specialist</h2>
      <p>
        Most non-ILR applications can be placed with a high street lender if
        the profile fits. Specialist lenders exist to take the cases the
        high street will not, usually on broader criteria but at higher
        rates. Private banks consider larger loans for high earners or
        significant deposits.
      </p>
      <p>
        The right route depends on the case. We work top down, starting
        with high street where realistic, moving to specialists or private
        only where the profile or borrowing requirement points there.
      </p>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="foreign-income-consideration">The foreign income consideration</h2>
      <p>
        If part of your income is paid in a foreign currency, paid by a
        foreign entity, or earned during periods spent outside the UK, you
        are also in foreign income territory. Most high street lenders apply
        a 20 per cent reduction to that income before assessment. A small
        number do not. For visa holders with significant overseas-paid
        income, this is often the largest single lever on the borrowing
        figure.
      </p>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="how-the-process-works">What the process looks like</h2>
      <p>
        We take the basic facts. Visa type and time remaining, income
        breakdown, deposit, target property and price. We map them against
        the current lender market and come back with the three to five
        lenders worth approaching, in order.
      </p>
      <p>
        A first conversation tells you whether the application is viable,
        what borrowing is realistic, and what the lender will want to see.
      </p>
    </div>
  </section>

  <MidPageCta />

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="faqs">Frequently asked questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </>
        ))}
      </div>
    </div>
  </section>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />
</HubLayout>
