---
import HubLayout from '../../layouts/HubLayout.astro';
import PullQuote from '../../components/PullQuote.astro';
import MidPageCta from '../../components/MidPageCta.astro';
import { breadcrumbSchema, serviceSchema } from '../../lib/schema';
import RiskWarning from '../../components/RiskWarning.astro';
import TerritorialScope from '../../components/TerritorialScope.astro';

const title = 'Santander International Expat Mortgage';
const description =
  'Santander International expat mortgage explained. Who qualifies, what rates and deposits to expect, and how it compares in the specialist expat market.';
const h1 = 'Santander International Mortgages: A Practical Guide';
const subheadline =
  'What Santander International lends on, who qualifies for an expat or non-resident UK mortgage with them, what rates and deposits to expect, and where Santander sits in the wider expat lender landscape.';

const relatedPages = [
  {
    eyebrow: 'Hub',
    title: 'Compare UK Expat Mortgage Lenders',
    description:
      'Santander International measured against HSBC Expat, NatWest International, Skipton International, and Barclays, and which profiles each tends to suit.',
    href: '/lenders',
  },
  {
    eyebrow: 'Hub',
    title: 'UK Mortgages for Expats',
    description:
      'British nationals living abroad. Country-by-country lender appetite, currency haircuts, and timelines.',
    href: '/expat-mortgages',
  },
  {
    eyebrow: 'Guide',
    title: 'Expat Mortgage Rates',
    description:
      'Why expat rates differ, what to expect by profile, and how lender choice moves the rate you pay.',
    href: '/expat-mortgages/rates',
  },
  {
    eyebrow: 'Hub',
    title: 'UK Mortgages for Non-UK Residents',
    description:
      'Foreign nationals or British expats wanting a UK mortgage on UK property. The lender pool, deposits, and rates explained.',
    href: '/non-uk-resident-mortgages',
  },
  {
    eyebrow: 'Lender',
    title: 'HSBC Expat Mortgages',
    description:
      'What HSBC Expat lends on, who qualifies, rates and deposits, and where HSBC sits in the wider expat lender landscape.',
    href: '/lenders/hsbc-expat',
  },
  {
    eyebrow: 'Lender',
    title: 'NatWest International Mortgages',
    description:
      'What NatWest International lends on, who qualifies, and where NatWest sits in the wider expat lender landscape.',
    href: '/lenders/natwest-international',
  },
  {
    eyebrow: 'Lender',
    title: 'Skipton International Mortgages',
    description:
      'What Skipton International lends on, who qualifies, and where Skipton sits in the wider expat lender landscape.',
    href: '/lenders/skipton-international',
  },
];

const faqs = [
  {
    q: 'Is Santander International the same as Santander UK?',
    a: 'No. Santander International is a separate offshore subsidiary based in Jersey, serving expats and non-UK residents.',
  },
  {
    q: 'Do I need to be a Santander customer to apply?',
    a: 'No, but applicants with an existing Santander banking relationship sometimes see smoother underwriting.',
  },
  {
    q: 'Does Santander International accept all countries?',
    a: 'No. Approved-countries list changes. Most major expat hubs are included.',
  },
  {
    q: 'What is the minimum income?',
    a: 'Santander International sets a working minimum income. Specifics change. Worth confirming current values directly.',
  },
  {
    q: 'What deposit do I need?',
    a: '25% minimum for residential, more for BTL.',
  },
  {
    q: 'Can I have a buy-to-let through Santander International?',
    a: 'Yes, with restrictions. Experienced landlords face fewer barriers than first-time landlords.',
  },
  {
    q: 'Does Santander International apply a currency haircut?',
    a: 'Yes, in line with other mainstream expat lenders. Worth confirming for your specific currency.',
  },
  {
    q: 'Is Santander International always the cheapest?',
    a: 'No. Worth comparing against specialist lenders before assuming.',
  },
  {
    q: 'Can I apply via a broker?',
    a: 'Yes. Most specialist expat brokers can place Santander International cases.',
  },
  {
    q: 'How long does an application take?',
    a: 'Typically six to ten weeks, similar to other expat lenders.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Santander International', path: '/lenders/santander-international' },
  ]),
  serviceSchema({
    serviceType: 'International Mortgage Lender Information',
    name: 'Santander International Mortgages Information',
    description,
  }),
];
---

<HubLayout
  title={title}
  description={description}
  h1={h1}
  subheadline={subheadline}
  eyebrow="LENDER · SANTANDER INTERNATIONAL"
  schemas={schemas}
  relatedPages={relatedPages}
>
  <RiskWarning type="residential" />
  <TerritorialScope />
  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="who-this-is-for">Who this page is for</h2>
      <p>If you are a British national living abroad, or a non-UK resident considering UK property, and you have looked at Santander International as a potential lender, this page is for you.</p>
      <p>Santander International is one of the major-bank options in the UK expat and non-resident mortgage market, alongside HSBC Expat and NatWest International. It carries the brand recognition of the wider Santander Group, which gives some applicants comfort over more specialist lenders.</p>
      <p>This page covers what Santander International actually lends on, where the criteria sit relative to other expat lenders, and where Santander is or is not the right fit. Independent guide, not a Santander product page.</p>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="what-it-is">What Santander International is</h2>
      <p>Santander International is the offshore arm of the Santander Group, headquartered in Jersey. The Jersey base means it operates under Channel Islands financial regulation rather than directly under UK FCA regulation, although the products it lends on are UK property.</p>
      <p>Santander International specialises in:</p>
      <ul>
        <li>UK mortgages for British expats living abroad.</li>
        <li>UK mortgages for non-UK residents.</li>
        <li>Buy-to-let lending to non-resident applicants, with restrictions.</li>
        <li>Residential lending for owner-occupier or future-return purchases.</li>
      </ul>
      <p>Santander International differs from Santander UK. Santander UK is the high-street mortgage lender that serves UK-resident borrowers. Santander International is the offshore arm serving expats. Eligibility, criteria, and pricing differ between the two.</p>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="who-qualifies">Who qualifies</h2>
      <p>Santander International broadly accepts:</p>
      <ul>
        <li>British nationals living abroad in approved countries (a list covering most major expat hubs).</li>
        <li>Non-UK national applicants in some scenarios, with restrictions.</li>
        <li>Salaried employees and self-employed applicants with sufficient documentation.</li>
        <li>Existing Santander banking customers, with priority treatment in some cases.</li>
        <li>Non-Santander customers, but with stricter criteria and rate.</li>
      </ul>
      <p>The approved-countries list changes periodically. Major expat markets like the UAE, Singapore, Hong Kong, Switzerland, USA, Canada, Australia, and most EU countries are typically included. Higher-risk jurisdictions are sometimes excluded.</p>
      <p>Income thresholds matter. Santander International sets a minimum income that reflects its target market, broadly in line with other mainstream offshore lenders rather than the entry-level end of the specialist market.</p>
    </div>
  </section>

  <MidPageCta variant="hero" />

  <PullQuote>
    Familiar UK banking group name does not always mean best rate. Worth
    comparing against the specialist lender pool.
  </PullQuote>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="loan-parameters">Property and loan parameters</h2>
      <p>Santander International typically lends on:</p>
      <ul>
        <li>UK residential property for owner-occupier or expat residence.</li>
        <li>UK buy-to-let for investment purposes, subject to additional criteria.</li>
        <li>Loan sizes from a working minimum upward, including high-value lending.</li>
        <li>Loan-to-value typically up to 75% on residential, less on BTL.</li>
        <li>Standard mortgage products, fixed and variable, with usual UK term lengths.</li>
      </ul>
      <p>What Santander International tends not to do:</p>
      <ul>
        <li>Very high LTVs above 75 to 80%.</li>
        <li>Adverse credit cases.</li>
        <li>Unusual property types.</li>
        <li>Borrowers from non-approved countries.</li>
        <li>First-time landlords in some cases.</li>
      </ul>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="rates">What rates to expect</h2>
      <p>Santander International typically prices in the middle of the expat lender pool. Existing banking customers sometimes see better rates than non-customers. Larger loans can attract more competitive pricing.</p>
      <p>The <a href="/expat-mortgages/rates">rate gap between Santander International and the best specialist expat lenders</a> is usually 0.1 to 0.4 percentage points either way, depending on the day and the profile. For some applicants Santander is the best deal in the market. For others a specialist lender beats Santander on rate, criteria, or both.</p>
      <p>Santander International rates are not always fully public. Best to compare via a broker who has access to Santander's current offerings alongside specialist lenders and other mainstream offshore names.</p>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="handles-well">What Santander International handles well</h2>
      <p>
        <strong>Existing Santander customers.</strong> Banking relationships
        translate into smoother application processes and sometimes better
        rates.
      </p>
      <p>
        <strong>Clean salaried profiles.</strong> Major employers, standard
        salary, predictable income. Santander International processes these
        efficiently.
      </p>
      <p>
        <strong>Larger loans.</strong> Santander International handles
        higher-value lending well, including for established professional
        applicants.
      </p>
      <p>
        <strong>Approved countries.</strong> Within their list, Santander
        International is comfortable lending across a wide range of expat
        markets.
      </p>
      <p>
        <strong>Brand and infrastructure.</strong> Established international
        banking group with a wide footprint. Some applicants prefer this over
        specialist lenders.
      </p>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="not-right-fit">Where Santander International may not be the best option</h2>
      <p>A few profiles where applicants benefit from looking beyond Santander International.</p>
      <p>
        <strong>Bonus-heavy or equity-heavy comp.</strong> Santander
        International is on the conservative side regarding variable comp.
        Senior employees with material bonus or equity components sometimes
        find better borrowing capacity with lenders that include more
        variable income.
      </p>
      <p>
        <strong>No-haircut on currency.</strong> Santander International
        applies a standard currency haircut. A small group of specialist
        lenders accepts gross income on certain currencies, which can
        materially increase borrowing capacity.
      </p>
      <p>
        <strong>Self-employed with limited UK presence.</strong> Santander
        International prefers salaried employees of established employers.
        Self-employed expats with personal services companies or consulting
        structures are sometimes better served by specialist lenders that
        understand those structures.
      </p>
      <p>
        <strong>Sub-Santander minimum income but strong asset base.</strong>
        Applicants below Santander's income threshold but with meaningful
        assets sometimes find better options with specialist lenders that
        weight assets more heavily.
      </p>
      <p>
        <strong>Niche country or currency.</strong> Applicants from
        non-approved countries or earning in less common currencies have
        specialist alternatives.
      </p>
      <p>
        <strong>First-time landlord BTL.</strong> Santander International
        has restrictions here. Specialist lenders that focus on non-resident
        BTL often handle this better.
      </p>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="how-to-apply">How to apply (and what a broker adds)</h2>
      <p>You can apply directly to Santander International. Existing banking customers usually have a relationship manager who can introduce them to a mortgage adviser.</p>
      <p>What we add, even when Santander turns out to be the right answer:</p>
      <p>
        <strong>Comparison.</strong> We can simultaneously model Santander
        International and three or four alternative lenders in parallel
        without footprinting your credit file at all of them. You see what
        each offers before committing.
      </p>
      <p>
        <strong>Packaging.</strong> Santander's underwriting prefers cases
        presented in a particular way. We place Santander cases regularly and
        know what to highlight, what to anticipate, and how to avoid the
        routine queries that delay underwriting.
      </p>
      <p>
        <strong>Backup.</strong> If Santander declines or offers worse than
        expected, we can switch to an alternative lender without restarting
        from scratch.
      </p>
      <p>
        <strong>Access to intermediary-only lenders.</strong> Several
        specialist expat lenders are intermediary-only and will not accept
        direct applications. A broker accesses them.
      </p>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="pitfalls">Common pitfalls</h2>
      <p><strong>Assuming Santander is the right answer because of the brand.</strong> Familiar banking group name does not always mean best rate. Worth comparing.</p>
      <p><strong>Applying directly without packaging.</strong> Self-applications are queried more than broker applications.</p>
      <p><strong>Underestimating the income threshold.</strong> Santander's minimum is firm. Applicants below should look elsewhere.</p>
      <p><strong>Ignoring the experienced-landlord preference.</strong> First-time non-resident BTL applicants often face friction with Santander International.</p>
      <p><strong>Country assumptions.</strong> Approved-countries list changes. Confirm current status before assuming.</p>
    </div>
  </section>

  <MidPageCta />

  <section class="hub-section">
    <div class="hub-section-inner">
      <h2 id="faqs">Frequently asked questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </>
        ))}
      </div>
    </div>
  </section>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />
</HubLayout>
