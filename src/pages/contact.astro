---
import T7Layout from '../layouts/T7Layout.astro';
import ContactForm from '../components/ContactForm.astro';

const title = 'Contact';
const description =
  'The fastest way to reach us is the enquiry form on any of our pages. A broker will be in touch, usually the same working day.';
import { breadcrumbSchema } from '../lib/schema';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' },
  ]),
];
---

<T7Layout title={title} description={description} h1="Contact" schemas={schemas}>
  <p>
    The fastest way to reach us is the enquiry form on any of our pages. Tell
    us where you live, what you earn, and what you want to buy. A broker will
    be in touch, usually the same working day.
  </p>
  <p>
    Enquiries are handled by Mortgage One, a trading style of Sandsea Capital
    Ltd, an appointed representative of Quilter Financial Services Limited,
    which is authorised and regulated by the Financial Conduct Authority.
  </p>
  <ContactForm />
</T7Layout>
