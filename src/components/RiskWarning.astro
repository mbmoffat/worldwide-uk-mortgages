---
interface Props {
  type?: 'residential' | 'btl' | 'fees' | 'residential-fees' | 'btl-fees';
}
const { type = 'residential' } = Astro.props;

const FEES_LINE =
  'A fee may be charged for mortgage advice. The amount will depend on your circumstances and will be agreed with you before any work is undertaken.';

const variants: Record<string, { disclaimer: string[]; fees?: string }> = {
  residential: {
    disclaimer: []
  },
  btl: {
    disclaimer: [
      'Your property may be repossessed if you do not keep up repayments on your mortgage.',
      'Some Buy to Let mortgages & House in Multiple Occupation mortgages are not regulated by the Financial Conduct Authority.'
    ]
  },
  fees: {
    disclaimer: [],
    fees: FEES_LINE
  },
  'residential-fees': {
    disclaimer: [],
    fees: FEES_LINE
  },
  'btl-fees': {
    disclaimer: [
      'Your property may be repossessed if you do not keep up repayments on your mortgage.',
      'Some Buy to Let mortgages & House in Multiple Occupation mortgages are not regulated by the Financial Conduct Authority.'
    ],
    fees: FEES_LINE
  }
};

const variant = variants[type];
const hasContent = variant.disclaimer.length > 0 || Boolean(variant.fees);
---

{hasContent && (
  <div class="risk-warning">
    {variant.disclaimer.map((line) => <p class="risk-warning-line">{line}</p>)}
    {variant.fees && <p class="risk-warning-fees">{variant.fees}</p>}
  </div>
)}

<style>
  .risk-warning {
    max-width: 820px;
    margin: 1.5rem auto 0.5rem;
    padding: 0 1rem;
  }
  .risk-warning p {
    font-family: var(--font-body);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: #1A1612;
    margin: 0;
    text-align: center;
  }
  .risk-warning .risk-warning-fees {
    margin-top: 1rem;
  }
</style>
